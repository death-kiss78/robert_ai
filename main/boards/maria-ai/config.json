{
    "type": "maria-ai",
    "target": "esp32s3",
    "builds": [
        {
            "name": "maria-ai",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m.csv\"",
				
                "CONFIG_FATFS_LFN_HEAP=y",
                "CONFIG_FATFS_MAX_LFN=255",
                "CONFIG_FATFS_CODEPAGE=437",
				"CONFIG_FLASH_CUSTOM_ASSETS=y",
				"CONFIG_CUSTOM_ASSETS_FILE=\"${CMAKE_CURRENT_SOURCE_DIR}/main/boards/maria-ai/assets.bin\"",

                "CONFIG_LANGUAGE_RO_RO=y",
                "CONFIG_SR_WN_WN9_SOPHIA_TTS=y",
				"CONFIG_WS_TRANSPORT=y",
				"CONFIG_WS_BUFFER_SIZE=1024",
				"CONFIG_MQTT_TRANSPORT_WEBSOCKET=y",
				"CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=y",
				"CONFIG_HTTPD_WS_SUPPORT=y",
				"CONFIG_HTTPD_WS_PREPARE_CB=y",
				"CONFIG_HTTPD_WS_HANDSHAKE_CB=y"
           ]
        }
    ]
}
